# این فایل را در .env کپی کن و مقادیر واقعی را جایگزین کن.
# هرگز فایل .env را (با مقادیر واقعی) وارد گیت نکن — در .gitignore هم هست.

# آدرس اتصال به PostgreSQL
# فرمت: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# رمز عبور ورود به پنل مدیریت (/admin/login)
# حتماً قبل از انتشار آنلاین این را به یک رمز قوی تغییر بده
ADMIN_PASSWORD=change-me-before-deploy

# کلید امضای HMAC برای کوکی نشست ادمین — یک رشته‌ی تصادفی و طولانی بگذار
# می‌توانی با دستور زیر یکی بسازی:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_AUTH_SECRET=change-me-to-a-random-secret

# توکن آپلود تصویر (Vercel Blob) — برای آپلود عکس در پنل مدیریت (اعضای تیم،
# پروژه‌ها) لازم است. راهنمای گرفتنش در README هست.
# روی سیستم خودت برای تست می‌توانی خالی بگذاری — فقط بخش آپلود عکس کار
# نمی‌کند و پیام خطای مناسب نشان داده می‌شود؛ باقی فرم‌ها مشکلی ندارند.
# روی Vercel، وقتی یک Blob Store می‌سازی، این مقدار خودش اضافه می‌شود.
BLOB_READ_WRITE_TOKEN=
